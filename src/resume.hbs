<!doctype html>
<html>

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, user-scalable=no, minimal-ui">
  <title>{{#resume.basics}}{{name}}{{/resume.basics}}</title>
  <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
  {{{ style }}}
  <style>
  .resume-wrapper {
    display: flex;
    flex-direction: row;
  }
  .left-column {
    width: 160px;
    margin-right: 20px;
  }
  .right-column {
    flex-grow: 1;
  }
</style>

</head>

<body>
  <main id="resume" class="page">
    {{> resume-header}}
    <div class="resume-content">
     <aside class="left-column">
        <div class="section-left">{{> about }}</div>
        <div class="section-left">{{> techstack }}</div>
        <div class="section-left">{{> skills }}</div>
        <div class="section-left">{{> languages }}</div>
        <div class="section-left">{{> interests }}</div>
    </aside>
      <div class="right-column">
        {{> summary}}
        {{> education }}
        {{> projects }}
        {{> internships }}
        {{> achievements }}
        {{> hobbies }}
      </div>
    </div>
  </main>
</body>

</html>
