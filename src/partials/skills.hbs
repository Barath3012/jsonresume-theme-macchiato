{{#if resume.skills.length}}
    <div class="skills-container">
    <section class="container">
      {{> title value="Key Skills"}}
        {{#each resume.skills}}
            
                
                {{#if name}}
                    <div class="minimal flex-container">
                        
                          <h6 class="main-skill skill">{{name}}</h6>
                        
                    </div>
                {{/if}}
        {{/each}}
      </section>
    </div>
{{/if}}
